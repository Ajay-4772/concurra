# ====================================================================
# OrderFlow - Master .gitignore
# ====================================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.gemini/

# Java & Maven
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# Spring Boot & Logging
logs/
*.log
spring.log

# Node & Frontend (Vite / React)
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker Volumes & Local DB Data
.docker/
docker/data/
postgres_data/
redis_data/
